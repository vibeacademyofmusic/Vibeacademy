# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
# Local Zalo gateway SSH material. Never commit.
/ssh-keygen -t ed25519 -C "vibe-zalo-gateway-staging"
/ssh-keygen -t ed25519 -C "vibe-zalo-gateway-staging".pub

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local page copies and one-off verification dumps. Keep them out of the source tree.
.backups/
*.bak
*.backup
*.broken-backup
*.before-*
